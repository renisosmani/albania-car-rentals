// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Dealer {
  id           String        @id @default(cuid())
  name         String
  phone        String?
  email        String?
  createdAt    DateTime      @default(now())
  pickupPoints PickupPoint[]
  cars         Car[]
}

model PickupPoint {
  id           String      @id @default(cuid())
  dealerId     String
  dealer       Dealer      @relation(fields: [dealerId], references: [id])
  name         String
  lat          Float
  lng          Float
  type         String      // SELF_PICKUP | KEY_DELIVERY | MEET_GREET
  instructions String?
  fee          Float?
  cars         Car[]
}

model Car {
  id                 String              @id @default(cuid())
  dealerId           String
  dealer             Dealer              @relation(fields: [dealerId], references: [id])
  defaultPickupPointId String
  defaultPickupPoint PickupPoint         @relation(fields: [defaultPickupPointId], references: [id])
  make               String
  model              String
  year               Int
  category           String              // ECONOMY | COMPACT | SUV | LUXURY
  pricePerDay        Float
  imageUrl           String?
  availabilityBlocks AvailabilityBlock[]
}

model AvailabilityBlock {
  id        String   @id @default(cuid())
  carId     String
  car       Car      @relation(fields: [carId], references: [id])
  startDate DateTime
  endDate   DateTime
}
